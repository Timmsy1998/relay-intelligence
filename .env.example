# Local development only. Cloud deployments require separate secrets.
DJANGO_SECRET_KEY=local-relay-development-key
RELAY_API_TOKEN=local-review-token
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=relay
CELERY_BROKER_URL=redis://redis:6379/0
EVENT_TRANSPORT=celery
LEDGER_BACKEND=mongo
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DD_SERVICE=relay-api
DD_ENV=development
DD_TRACE_ENABLED=false
